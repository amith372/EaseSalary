# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the one that carries names and no values, so a fresh clone learns
# what it has to fill in without anyone having to remember to tell it.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# spreadsheets — every one is ignored except the scrubbed export templates.
# The family's own workbooks hold names, passport and bank numbers and must never
# reach GitHub; data/templates/template_*.xlsx are load-bearing (the export fills
# them) and carry placeholders only. hooks/pre-commit refuses a forced add too.
*.xlsx
*.xlsm
*.xls
*.xlsb
*.ods
*.csv
~$*
!/data/templates/template_*.xlsx

# agent skill scratch output — throwaway ticket files, never load-bearing
/.scratch/

# playwright
/test-results/
/playwright-report/
/blob-report/
/.playwright/

# playwright — the signed-in state the browser suite starts from
/e2e/.auth/

# impeccable — the critique and audit snapshots the skill writes. They describe
# the code at one moment and go stale the next time a screen changes, so they
# are working notes rather than a record: what a review found belongs in the
# code, the tests, or the commit that acted on it.
/.impeccable/
