# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the one that carries names and no values, so a fresh clone learns
# what it has to fill in without anyone having to remember to tell it.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# data files — DO NOT ignore *.xlsx.
# data/templates/*.xlsx are load-bearing: the .xlsx export is generated from them.
# (The parent directory's repo ignores *.xlsx; this repo must not inherit that.)
!*.xlsx

# agent skill scratch output — throwaway ticket files, never load-bearing
/.scratch/

# playwright
/test-results/
/playwright-report/
/blob-report/
/.playwright/
