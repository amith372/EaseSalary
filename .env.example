# EaseSalary — the values the application reads from the environment.

# ---------------------------------------------------------------------------
# Supabase — Postgres and Auth.
# Dashboard → your project → Project Settings → API.
# ---------------------------------------------------------------------------

# The project's address, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The publishable key. It reaches the browser by design and is safe there
# **only because row-level security stands behind it**: it identifies the
# project, not the person, and every table's policies decide what the signed-in
# person may read. Labelled `anon` `public` in the dashboard, or
# `publishable` in a project created recently.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The key that bypasses row-level security entirely. It is used on the server
# and nowhere else — never in a client component, never in a `NEXT_PUBLIC_`
# name — and a copy of it is a copy of every household's data. Labelled
# `service_role` `secret` in the dashboard, or `secret` in a recent project.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Encryption at rest.
# ---------------------------------------------------------------------------

# The key the four identifying numbers are encrypted with — the passport, bank
# account, employment permit and work visa numbers (specs.md Part 3, items 22
# and 28). It lives **outside the database** so that a copy of the database on
# its own reveals nothing, which means it is not a value Supabase can be asked
# for: losing it makes those four columns unreadable for good.
#
# 32 random bytes, base64. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
